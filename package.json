{
  "name": "arbiter",
  "version": "0.1.0",
  "private": true,
  "description": "ARBITER — approval-gated Revenue Recovery Decision Engine (Razorpay AI Buildathon, Track 03)",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm -r typecheck && pnpm test",
    "seed": "tsx packages/seed/src/main.ts --corpus all",
    "seed:demo": "tsx packages/seed/src/main.ts --corpus demo",
    "demo": "tsx scripts/demo.ts",
    "demo:batch": "tsx scripts/demo.ts",
    "train": "tsx packages/ml/src/main.ts",
    "propose": "tsx packages/ml/src/propose.ts",
    "execute": "tsx packages/ml/src/execute.ts",
    "recover": "tsx packages/ml/src/recover.ts",
    "trial": "tsx packages/trial/src/run.ts",
    "build": "echo 'Running via tsx, skipping build'",
    "start": "tsx app/server.ts",
    "dev": "tsx app/server.ts",
    "clean:db": "rm -f data/arbiter.sqlite* && pnpm db:migrate",
    "db:clean": "tsx scripts/truncate_db.ts",
    "db:migrate": "tsx packages/core/src/db/migrate.ts"
  },


  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "qrcode": "^1.5.4"
  }
}

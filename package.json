{
  "name": "arbiter",
  "version": "0.1.0",
  "private": true,
  "description": "ARBITER — approval-gated Revenue Recovery Decision Engine (Razorpay AI Buildathon, Track 03)",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm -r typecheck && pnpm test",
    "seed": "tsx packages/seed/src/main.ts --corpus all",
    "seed:demo": "tsx packages/seed/src/main.ts --corpus demo",
    "train": "tsx packages/ml/src/main.ts",
    "db:migrate": "tsx packages/core/src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

# ==============================================================================
#  ARBITER — Payment Failure Recovery Engine (.env.example)
#  Copy this file to `.env` (`cp .env.example .env`) and fill in your keys.
# ==============================================================================

# ── 1. CORE PAYMENT GATEWAY (Razorpay Test Mode) ──────────────────────────────
# Free Test Mode: Instant access without KYC.
# Get free keys at: https://dashboard.razorpay.com/app/keys
PAYMENT_MODE=LOCAL_SANDBOX          # Options: "LOCAL_SANDBOX" (deterministic simulation) | "REAL_SANDBOX" (Razorpay Test Mode)
RZP_TEST_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_TEST_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RZP_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx # Webhook Secret from: https://dashboard.razorpay.com/app/webhooks

# ── 2. TRANSACTIONAL EMAIL PROVIDER (Brevo / Sendinblue) ─────────────────────
# Free Tier: 300 free emails/day forever with zero credit card required.
# Get free API key at: https://app.brevo.com/settings/keys/api
# Sign up link: https://www.brevo.com/ (Click "Sign up free")
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx
BREVO_SENDER_EMAIL=billing@arbiter.in
BREVO_SENDER_NAME=ARBITER Recovery
BREVO_WEBHOOK_SECRET=whsec_brevo_optional

# ── 3. TRANSACTIONAL SMS & DLT ROUTE (MSG91) ─────────────────────────────────
# Free Tier: 1,000 free SMS testing credits on sign-up.
# Get free AuthKey at: https://control.msg91.com/signup/
# AuthKey Dashboard: https://msg91.com/app/user/api-key
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MSG91_SENDER_ID=ARBITR
MSG91_DLT_TEMPLATE_ID=1407168923450011
MSG91_FLOW_ID=flow_insufficient_01

# ── 4. OUTBOUND VOICE IVR & PRESS-1 (Twilio) ─────────────────────────────────
# Free Tier: Free $15 trial credit covering ~1,000 voice calls & SMS.
# Sign up link: https://www.twilio.com/try-twilio
# Console & Keys: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1234567890
TWILIO_WEBHOOK_BASE_URL=https://pay.arbiter.in

# ── 5. WHATSAPP BUSINESS MESSAGING (Gupshup Sandbox) ──────────────────────────
# Free Tier: Free interactive WhatsApp Sandbox for testing.
# Sign up link: https://www.gupshup.io/developer/home
# Sandbox API Key: https://www.gupshup.io/developer/dashboard
GUPSHUP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GUPSHUP_APP_NAME=ARBITER
GUPSHUP_SOURCE_NUMBER=919000000000
GUPSHUP_WEBHOOK_SECRET=whsec_gupshup_optional

# ── 6. OFFLINE LLM NARRATIVE GENERATION (Anthropic / Gemini) ──────────────────
# Note: Never in the high-speed money path! Only used for post-recovery executive briefs.
# Anthropic: $5 free credit at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini (Alternative Free Option): 15 RPM / 1M TPM 100% Free
# Get free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 7. APPLICATION & DATABASE RUNTIME CONFIGURATION ───────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ARBITER_DB_PATH=./data/arbiter.sqlite
ARBITER_POLICY_PATH=config/policy.yaml
ADMIN_SECRET_KEY=arbiter_admin_secret_key_demo_2026
ENFORCE_ADMIN_KEY=false

# ── ARBITER environment ─────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# Razorpay — TEST MODE keys only (Dashboard → Settings → API Keys)
RZP_TEST_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_TEST_KEY_SECRET=test_secret_xxxxxxxxxxxx

# Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Optional — narrative layer only (never in the money path). Fallback used if unset.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Buildathon application form — record these, they are project-critical
# ARBITER_DEADLINE_UTC=2026-09-05T23:59:00Z

# Local runtime
ARBITER_DB_PATH=./data/arbiter.sqlite
NODE_ENV=development

# Webhook endpoint secret (Razorpay Dashboard → Webhooks) — NOT the key secret
RZP_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
